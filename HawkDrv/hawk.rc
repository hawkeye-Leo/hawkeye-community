#include <windows.h>

#include "HawkeyeVersion.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION HAWKEYE_VERSION_RC_FILEVER
 PRODUCTVERSION HAWKEYE_VERSION_RC_PRODUCTVER
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DRV
 FILESUBTYPE VFT2_DRV_SYSTEM
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", HAWKEYE_COMPANY_NAME
            VALUE "FileDescription", "Hawkeye Community Driver"
            VALUE "FileVersion", HAWKEYE_VERSION_STRING_FULL
            VALUE "InternalName", "Hawkeye.sys"
            VALUE "LegalCopyright", HAWKEYE_LEGAL_COPYRIGHT
            VALUE "OriginalFilename", "Hawkeye.sys"
            VALUE "ProductName", HAWKEYE_PRODUCT_NAME
            VALUE "ProductVersion", HAWKEYE_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
