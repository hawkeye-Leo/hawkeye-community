    <PostBuildEvent>
      <Command>xcopy /y /d "C:\Program Files (x86)\Windows Kits\10\Debuggers\x64\dbghelp.dll" "$(OutDir)"
xcopy /y /d "C:\Program Files (x86)\Windows Kits\10\Debuggers\x64\symsrv.dll" "$(OutDir)"
if not exist "$(OutDir)sim" mkdir "$(OutDir)sim"
xcopy /y /d "$(ProjectDir)..\..\..\samples\HawkUnsignedStub\bin\Release\HawkUnsignedStub.dll" "$(OutDir)sim\"
if /I not "$(Configuration)"=="Release" goto skip_hawkeye_sign
if /I not "$(Platform)"=="x64" goto skip_hawkeye_sign
setlocal EnableDelayedExpansion
set "SIGNTOOL="
for /d %%D in ("$(WindowsSdkDir)bin\10.*") do if exist "%%~D\x64\signtool.exe" set "SIGNTOOL=%%~D\x64\signtool.exe"
if not defined SIGNTOOL (
  echo signtool.exe not found under "$(WindowsSdkDir)bin"
  exit /b 1
)
"!SIGNTOOL!" sign /v /s My /n "Hawkeye Test Certificate" /fd SHA256 /ph "$(TargetPath)"
if errorlevel 1 exit /b 1
if not exist "$(ProjectDir)..\..\..\bin" mkdir "$(ProjectDir)..\..\..\bin"
copy /y "$(TargetPath)" "$(ProjectDir)..\..\..\bin\Hawkeye.exe"
if errorlevel 1 exit /b 1
endlocal
:skip_hawkeye_sign</Command>
      <Message>Copy dbghelp/symsrv/stub; Release|x64 test-signs Hawkeye.exe and copies it to repo bin</Message>
    </PostBuildEvent>
